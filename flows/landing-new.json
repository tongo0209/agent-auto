{
  "id": "landing-new",
  "label": "Dựng landing mới từ design",
  "ask": [
    {
      "need": [
        "campaignDir"
      ],
      "question": "Folder campaign (products/<game>/landing/<slug>) của ticket là gì?"
    },
    {
      "need": [
        "gameplayOk"
      ],
      "question": "Gameplay là gì — khoá theo cặp AI-RULES nào (project-note lock, R-PM-11)?"
    },
    {
      "need": [
        "hasRawDesign"
      ],
      "question": "File design gốc (PSD/Figma) nằm ở đâu?"
    }
  ],
  "stages": [
    {
      "id": "intake",
      "kind": "parallel",
      "branches": [
        [
          "cut"
        ],
        [
          "check-design"
        ]
      ],
      "onRevise": "design-gap",
      "next": "spec"
    },
    {
      "id": "cut",
      "kind": "claude",
      "prompt": "cut.md",
      "toolset": "cut",
      "model": "opus",
      "lock": "photoshop"
    },
    {
      "id": "check-design",
      "kind": "claude",
      "prompt": "check-design.md",
      "toolset": "review",
      "model": "opus"
    },
    {
      "id": "design-gap",
      "kind": "pause",
      "show": [
        "check-design-r*.json"
      ],
      "next": "spec"
    },
    {
      "id": "spec",
      "kind": "claude",
      "prompt": "spec.md",
      "toolset": "implement",
      "model": "opus",
      "next": "plan"
    },
    {
      "id": "plan",
      "kind": "claude",
      "prompt": "plan.md",
      "toolset": "review",
      "model": "opus",
      "next": "plan-review"
    },
    {
      "id": "plan-review",
      "kind": "claude",
      "prompt": "plan-review.md",
      "toolset": "review",
      "model": "opus",
      "next": "approve-plan",
      "loop": {
        "back": "plan",
        "max": 3
      }
    },
    {
      "id": "approve-plan",
      "kind": "pause",
      "show": [
        "plan.md",
        "plan-review-r*.json"
      ],
      "onReject": "plan",
      "next": "sections"
    },
    {
      "id": "sections",
      "kind": "sections",
      "when": "multiSection",
      "lane": "implement-section",
      "review": "section-review",
      "build": "section-build",
      "ui": "section-ui",
      "fix": "fix-section",
      "rounds": 3,
      "maxAgents": 5,
      "next": "implement"
    },
    {
      "id": "implement-section",
      "kind": "claude",
      "prompt": "implement-section.md",
      "toolset": "implement",
      "model": "opus",
      "keepSession": true
    },
    {
      "id": "section-review",
      "kind": "claude",
      "prompt": "section-review.md",
      "toolset": "review",
      "model": "opus"
    },
    {
      "id": "section-build",
      "kind": "gate",
      "checks": [
        "build"
      ]
    },
    {
      "id": "section-ui",
      "kind": "claude",
      "prompt": "section-ui.md",
      "toolset": "browser",
      "model": "sonnet"
    },
    {
      "id": "fix-section",
      "kind": "claude",
      "prompt": "fix-section.md",
      "toolset": "implement",
      "model": "opus"
    },
    {
      "id": "implement",
      "kind": "claude",
      "prompt": "implement.md",
      "toolset": "implement",
      "model": "opus",
      "timeoutMinutes": 60,
      "next": "checks",
      "keepSession": true,
      "when": "singleSection"
    },
    {
      "id": "checks",
      "kind": "parallel",
      "branches": [
        [
          "code-review"
        ],
        [
          "gates",
          [
            "ui-check",
            "design-compare"
          ]
        ]
      ],
      "loop": {
        "back": "fix",
        "max": 3
      },
      "next": "clean-code"
    },
    {
      "id": "code-review",
      "kind": "claude",
      "prompt": "code-review.md",
      "toolset": "review",
      "model": "opus"
    },
    {
      "id": "gates",
      "kind": "gate",
      "checks": [
        "build",
        "pm-gate",
        "fe-gate",
        "landing-parity",
        "layout-gate"
      ]
    },
    {
      "id": "ui-check",
      "kind": "claude",
      "prompt": "ui-check.md",
      "toolset": "browser",
      "model": "sonnet"
    },
    {
      "id": "design-compare",
      "kind": "claude",
      "prompt": "design-compare.md",
      "toolset": "browser",
      "model": "opus",
      "requireEvidence": true
    },
    {
      "id": "clean-code",
      "kind": "claude",
      "prompt": "clean-code.md",
      "toolset": "implement",
      "model": "opus",
      "next": "gates-final"
    },
    {
      "id": "gates-final",
      "kind": "gate",
      "checks": [
        "build",
        "pm-gate",
        "fe-gate",
        "landing-parity",
        "layout-gate"
      ],
      "loop": {
        "back": "fix",
        "max": 2
      },
      "next": "handoff"
    },
    {
      "id": "handoff",
      "kind": "claude",
      "prompt": "handoff.md",
      "toolset": "implement",
      "model": "sonnet",
      "when": "hasHandoff",
      "next": "handoff-gates"
    },
    {
      "id": "handoff-gates",
      "kind": "gate",
      "scope": "handoff",
      "when": "hasHandoff",
      "checks": [
        "pm-gate-handoff",
        "check-promotion"
      ],
      "loop": {
        "back": "fix",
        "max": 2
      },
      "next": "approve-result"
    },
    {
      "id": "fix",
      "kind": "claude",
      "prompt": "fix.md",
      "toolset": "implement",
      "model": "opus",
      "resume": "implement",
      "returnTo": "caller"
    },
    {
      "id": "approve-result",
      "kind": "pause",
      "show": [
        "diff",
        "receipts",
        "design-compare-r*.json"
      ],
      "onReject": "fix",
      "rejectReturnTo": "checks",
      "next": "commit"
    },
    {
      "id": "commit",
      "kind": "gate",
      "checks": [
        "commit"
      ],
      "next": null
    }
  ]
}
