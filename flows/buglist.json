{
  "id": "buglist",
  "label": "Xử lý buglist QC",
  "budget": {
    "usd": 30,
    "minutes": 150
  },
  "ask": [
    {
      "need": [
        "!sheetNoBugId"
      ],
      "question": "Sheet không có cột BugID/No. (radar mù) — thêm cột BugID hay chỉ định cột nào định danh bug?"
    },
    {
      "need": [
        "campaignDir"
      ],
      "question": "Folder campaign (products/<game>/landing/<slug>) của ticket là gì?"
    }
  ],
  "stages": [
    {
      "id": "drift-check",
      "kind": "claude",
      "prompt": "drift-check.md",
      "toolset": "drift",
      "model": "sonnet",
      "when": "hasHandoff",
      "next": "intake-triage"
    },
    {
      "id": "intake-triage",
      "kind": "claude",
      "prompt": "intake-triage.md",
      "toolset": "intake",
      "model": "opus",
      "next": "lanes"
    },
    {
      "id": "lanes",
      "kind": "claude",
      "prompt": "lanes.md",
      "toolset": "implement",
      "model": "opus",
      "next": "gates",
      "keepSession": true
    },
    {
      "id": "gates",
      "kind": "gate",
      "checks": [
        "build"
      ],
      "loop": {
        "back": "fix",
        "max": 2
      },
      "next": "pm-gates"
    },
    {
      "id": "pm-gates",
      "kind": "gate",
      "when": "touchesPm",
      "checks": [
        "pm-gate"
      ],
      "loop": {
        "back": "fix",
        "max": 2
      },
      "next": "ui-check"
    },
    {
      "id": "ui-check",
      "kind": "claude",
      "prompt": "ui-check.md",
      "toolset": "browser",
      "model": "sonnet",
      "when": "touchesUi",
      "loop": {
        "back": "fix",
        "max": 2
      },
      "next": "verify"
    },
    {
      "id": "verify",
      "kind": "claude",
      "prompt": "verify.md",
      "toolset": "browser",
      "model": "sonnet",
      "next": "handoff",
      "loop": {
        "back": "fix",
        "max": 2
      }
    },
    {
      "id": "handoff",
      "kind": "claude",
      "prompt": "handoff.md",
      "toolset": "implement",
      "model": "sonnet",
      "when": "hasHandoff",
      "next": "handoff-gates"
    },
    {
      "id": "handoff-gates",
      "kind": "gate",
      "scope": "handoff",
      "when": "hasHandoff",
      "checks": [
        "pm-gate-handoff",
        "check-promotion"
      ],
      "loop": {
        "back": "fix",
        "max": 2
      },
      "next": "approve-result"
    },
    {
      "id": "fix",
      "kind": "claude",
      "prompt": "fix.md",
      "toolset": "implement",
      "model": "opus",
      "resume": "lanes",
      "returnTo": "caller"
    },
    {
      "id": "approve-result",
      "kind": "pause",
      "show": [
        "diff",
        "receipts"
      ],
      "onReject": "fix",
      "rejectReturnTo": "gates",
      "next": "commit"
    },
    {
      "id": "commit",
      "kind": "gate",
      "checks": [
        "commit"
      ],
      "next": "write-sheet"
    },
    {
      "id": "write-sheet",
      "kind": "attached",
      "command": {
        "google": "/bug-fixer-lite report",
        "excel": "python3 tools/bug-sheet-tick.py (Graph API) — không ghi được thì xuất block dán tay cột Status"
      },
      "realWrite": true,
      "next": null
    }
  ]
}
